{
  "name": "open-iptv-pro",
  "productName": "Open IPTV Pro",
  "version": "4.16.0",
  "description": "Open-source desktop IPTV player for Windows and macOS with eight interface languages, M3U playlists, EPG, MultiView, snapshots and stream diagnostics",
  "main": "src/main.cjs",
  "author": "Open IPTV Pro contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:mac:arm64": "electron-builder --mac --arm64 --publish never",
    "dist:mac:x64": "electron-builder --mac --x64 --publish never",
    "dist:mac:universal": "electron-builder --mac --universal --publish never",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:dir": "electron-builder --dir"
  },
  "dependencies": {
    "hls.js": "1.6.15",
    "ffmpeg-static": "5.3.0",
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "38.0.0",
    "electron-builder": "26.0.0"
  },
  "build": {
    "appId": "org.openiptvpro.desktop",
    "productName": "Open IPTV Pro",
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "files": [
      "renderer/**/*",
      "src/**/*",
      "assets/icon.png",
      "node_modules/**/*",
      "package.json",
      "!**/*.map"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "icon": "assets/icon.icns",
      "artifactName": "Open-IPTV-Pro-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Open IPTV Pro ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Open-IPTV-Pro-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Open-IPTV-Pro-Setup-${version}-${arch}.${ext}"
    },
    "icon": "assets/icon.png",
    "publish": [
      {
        "provider": "github",
        "owner": "trisanghy",
        "repo": "open-iptv-pro",
        "releaseType": "release"
      }
    ]
  }
}
