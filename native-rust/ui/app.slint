                                 HorizontalLayout { Button { text: "AMOLED"; clicked => { root.set-theme("AMOLED"); } } Button { text: "Apple tối"; clicked => { root.set-theme("Apple tối"); } } Button { text: "Material 3"; clicked => { root.set-theme("Material 3"); } } }
                                Rectangle { height: 1px; background: #344157; }
                                Text { text: "NGUỒN M3U"; color: root.accent; font-weight: 700; font-size: 12px; }
                                HorizontalLayout {
