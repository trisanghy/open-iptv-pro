                            HorizontalLayout { Button { text: "+ Tạo thư mục"; clicked => { root.create-folder(); } } Button { text: "+ Thêm kênh đang phát"; clicked => { root.put-in-folder(); } } Button { text: "Xem thư mục"; clicked => { root.show-folder(root.folder-input); } } Button { text: "Tất cả kênh"; clicked => { root.clear-folder(); } } }
                            Text { text: "Thư mục này chỉ thuộc bản Rust Native."; color: #99afc2; font-size: 11px; }
                        }
