                            Text { text: "Chụp kênh đang chọn hoặc chụp theo lô với FFmpeg. Cache tự kiểm tra hạn 6 giờ."; color: #a9c0d8; font-size: 12px; }
                            HorizontalLayout { Button { text: "Chụp kênh đang chọn"; clicked => { root.snapshot-current(); } } Button { text: "Chụp 10 kênh đầu danh sách"; clicked => { root.snapshot-all(); } } }
                            Text { text: "Ảnh lưu trong thư mục dữ liệu của Rust Native; không ghi đè Snapshot Electron."; color: #96b6cb; font-size: 12px; }
