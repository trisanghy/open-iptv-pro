                                Rectangle { height: 1px; background: #344157; }
                                Text { text: "EPG / LỊCH PHÁT SÓNG"; color: root.accent; font-weight: 700; font-size: 12px; }
                                 HorizontalLayout {
                                     Text { text: root.epg-auto-refresh-enabled ? "Tự cập nhật EPG khi ứng dụng đang mở: BẬT" : "Tự cập nhật EPG khi ứng dụng đang mở: TẮT"; color: #a9c2d6; font-size: 12px; }
                                     Button { text: "Bật / Tắt"; clicked => { root.toggle-epg-auto-refresh(); } }
                                 }
                                 Text { text: "Nguồn lịch tự tải khi khởi động; làm mới mỗi 10 phút khi bật. Giữ lịch cũ khi mạng lỗi."; color: #91a9c3; font-size: 11px; }
                                 Rectangle { height: 1px; background: #344157; }
                                 Text { text: "TRÌNH PHÁT / HIỂN THỊ"; color: root.accent; font-weight: 700; font-size: 12px; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: "Đầu ra video: " + (root.video-backend-mode == "native" ? "Cửa sổ mpv riêng" : "Nhúng vào Slint"); color: #a9c2d6; font-size: 12px; vertical-alignment: center; }
                                    Button { text: "Nhúng Slint"; clicked => { root.select-video-backend("embedded"); } }
                                    Button { text: "Cửa sổ mpv"; clicked => { root.select-video-backend("native"); } }
                                }
                                Text { text: "Đổi đầu ra sẽ tải lại kênh đang phát. Nếu chưa có hình trong Slint, chọn Cửa sổ mpv."; color: #91a9c3; font-size: 11px; }
                                 Text { text: "Khung hình mặc định: " + root.aspect-mode-text; color: #a9c2d6; font-size: 12px; }
                                 HorizontalLayout { Button { text: "Vừa khung"; clicked => { root.set-aspect-mode("fit"); } } Button { text: "Lấp đầy"; clicked => { root.set-aspect-mode("fill"); } } Button { text: "Gốc"; clicked => { root.set-aspect-mode("original"); } } Button { text: root.muted ? "Bật tiếng" : "Tắt tiếng"; clicked => { root.toggle-mute(); } } }
                                 HorizontalLayout {
                                     Text { text: root.auto-resume-last-channel ? "Tự mở lại kênh khi khởi động: BẬT" : "Tự mở lại kênh khi khởi động: TẮT"; color: #a9c2d6; font-size: 12px; vertical-alignment: center; }
                                     Button { text: "Bật / Tắt"; clicked => { root.toggle-resume-last-channel(); } }
                                 }
                                 Text { text: "Chế độ phát và trạng thái công cụ nhanh được lưu riêng trong Rust Native."; color: #91a9c3; font-size: 11px; }
                                 Rectangle { height: 1px; background: #344157; }
                                 Text { text: "SAO LƯU / KHÔI PHỤC"; color: root.accent; font-weight: 700; font-size: 12px; }
                                Button { text: "Nhập backup Electron (.iptvbackup)"; clicked => { root.import-electron-backup(); } }
                                Button { text: "Nhập backup Rust (.json)"; clicked => { root.import-native-backup(); } }
                                Button { text: "Xuất backup Rust (.json)"; clicked => { root.export-native-backup(); } }
                                Rectangle { height: 1px; background: #344157; }
                                Text { text: "VIDEO / GHI HÌNH"; color: root.accent; font-weight: 700; font-size: 12px; }
                                Text { text: "Âm lượng: " + root.volume-text; color: #abc2d6; font-size: 13px; }
                                HorizontalLayout { Button { text: "Giảm âm"; clicked => { root.volume-delta(-10); } } Button { text: "Tăng âm"; clicked => { root.volume-delta(10); } } Button { text: "Dừng ghi hình"; clicked => { root.stop-recording(); } } }
                                Text { text: root.recording-text; color: #a9bdcf; font-size: 12px; }
                                Rectangle { height: 1px; background: #344157; }
                                Text { text: "Thông tin dự án"; color: #f2f6ff; font-weight: 700; font-size: 13px; }
                                Text { text: "C3 experimental · Rust + Slint 1.18.1 + libmpv (cửa sổ riêng)"; color: #92adc6; font-size: 12px; }
                                AboutSlint { height: 35px; }
                            }
                        }
                    }
                }
            }
            if !root.player-fullscreen : Rectangle {
                height: 34px;
                background: root.light-mode ? #f6f8fd : #152131;
                border-width: 1px;
                border-color: #24374c;
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 17px;
                    Text { text: "● " + root.status-text; color: #a9bed7; font-size: 11px; overflow: elide; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; background: root.light-mode ? #f6f8fd : #152131; }
                    Text { text: root.count-text; color: #90a6bd; font-size: 11px; vertical-alignment: center; }
                }
            }
        }
    }
}
