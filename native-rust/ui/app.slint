                            Text { text: root.active-page == "health" ? "↗ Sức khỏe kênh / Failover" : "✚ Smart IPTV Doctor"; color: root.light-mode ? #203249 : #f3f6ff; font-size: 21px; font-weight: 700; }
                            Text { text: "Kiểm tra theo lô tối đa 1.000 kênh. Timeout, lỗi CDN và chặn HEAD chỉ đánh dấu Chưa rõ, không tự kết luận Die."; color: #a8c1d6; wrap: word-wrap; font-size: 12px; }
                            HorizontalLayout { Button { text: "Kiểm tra kênh đang phát"; clicked => { root.check-selected-channel(); } } Button { text: "Kiểm tra tối đa 1.000 kênh"; clicked => { root.check-channels(); } } }
