                                Text { text: "Bản thử nghiệm Slint sử dụng cùng bố cục sidebar/điều khiển; chưa sử dụng được toàn bộ CSS và 10 theme Electron."; color: #a8c1d6; wrap: word-wrap; font-size: 12px; }
                                Text { text: "Giao diện: " + root.current-theme; color: root.accent; font-size: 13px; }
