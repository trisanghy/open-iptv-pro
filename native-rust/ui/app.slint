// Experiment C3: native reinterpretation of Open IPTV Pro v4.23.17 desktop.
// Layout and labels follow the Electron navigation, with an explicit distinction
// between implemented controls and native video-render integration pending.
import { Button, LineEdit, ListView, ScrollView, AboutSlint, CheckBox, ComboBox, Slider } from "std-widgets.slint";

export struct ChannelView {
    title: string,
    subtitle: string,
    logo: image,
    has-logo: bool,
    epg: string,
    favorite: bool,
    health: string,
}
export struct GuideView {
    channel: string,
    time: string,
    title: string,
}
export struct SourceView {
    title: string,
    count: string,
}
export struct JobView {
    title: string,
    detail: string,
}

export component MainWindow inherits Window {
    title: "Open IPTV Pro · Rust Native · Experiment C3";
    preferred-width: 1420px;
    preferred-height: 890px;
    min-width: 980px;
    min-height: 650px;
    background: root.amoled-mode ? #000000 : (root.light-mode ? #eef3f9 : #0c1520);
    default-font-family: "Helvetica Neue";
    full-screen: root.player-fullscreen;

    in-out property <bool> light-mode: false;
    in-out property <brush> accent: #bc7cff;
    in-out property <string> active-page: "tv";
    in-out property <string> page-title: "Xem truyền hình";
    in-out property <string> url-input;
    in-out property <string> source-edit-url;
    in-out property <string> source-edit-name;
    in-out property <string> epg-url-input;
    in-out property <string> epg-search;
    in-out property <string> guide-day-text: "Hôm nay";
    in-out property <string> guide-count: "Chưa tải đầy đủ EPG";
    in-out property <[GuideView]> guide-rows;
    in-out property <bool> epg-auto-refresh-enabled: true;
    in-out property <bool> source-auto-refresh-enabled: true;
    in-out property <bool> quick-tools-expanded: false;
    in-out property <bool> muted: false;
    in-out property <string> aspect-mode-text: "Vừa khung";
    in-out property <bool> auto-resume-last-channel: false;
    in-out property <bool> amoled-mode: false;
    in-out property <bool> import-rights-confirmed: false;
    in-out property <bool> discovery-rights-confirmed: false;
    in-out property <string> search-text;
    in-out property <string> folder-input;
    in-out property <string> selected-source-text: "Tất cả nguồn";
    in-out property <string> playing-text: "Chưa chọn kênh";
    in-out property <string> playing-subtitle: "Nhập danh sách để bắt đầu";
    in-out property <string> status-text: "Sẵn sàng";
    in-out property <string> count-text: "0 kênh";
    in-out property <bool> show-pagination: false;
    in-out property <string> favorites-count: "0";
    in-out property <string> recent-count: "0";
    in-out property <string> alternate-input;
    in-out property <string> alternates-text: "Chưa chọn kênh";
    in-out property <string> auto-failover-text: "Đang bật";
    in-out property <string> sources-count: "0";
    in-out property <string> volume-text: "80%";
    in-out property <string> selected-epg-text: "Chưa có dữ liệu EPG";
    in-out property <string> selected-health-text: "Chưa kiểm tra";
    in-out property <string> recording-text: "Chưa ghi hình";
    in-out property <string> video-hint: "Chọn kênh bên dưới để phát";
    in-out property <image> video-frame;
    in-out property <bool> has-video-frame: false;
    in-out property <bool> player-fullscreen: false;
    in-out property <bool> rail-collapsed: true;
    in-out property <bool> video-paused: false;
    in-out property <bool> playback-controls-enabled: false;
    in-out property <bool> video-is-live: true;
    in-out property <bool> video-seekable: false;
    in-out property <string> video-status: "Chưa phát";
    in-out property <string> video-backend-mode: "embedded";
    in-out property <string> playback-clock: "--:-- / --:--";
    in-out property <float> playback-progress: 0;
    in-out property <string> source-hint: "Chưa có nguồn phát";
    in-out property <string> current-theme: "Tối · Tím";
    in-out property <int> selected-channel-index: -1;
    in-out property <[ChannelView]> channels;
    in-out property <[SourceView]> sources;
    in-out property <[JobView]> jobs;

    callback navigate(string);
    callback add-url();
    callback open-m3u();
    callback import-electron-backup();
    callback import-native-backup();
    callback export-native-backup();
    callback import-epg();
    callback load-epg-url();
    callback select-epg-preset(string);
    callback guide-filter-changed(string);
    callback guide-day(int);
    callback toggle-epg-auto-refresh();
    callback toggle-source-auto-refresh();
    callback toggle-quick-tools();
    callback set-aspect-mode(string);
    callback toggle-mute();
    callback toggle-resume-last-channel();
    callback select-source(int);
    callback update-source-url();
    callback rename-source();
    callback show-all();
    callback show-favorites();
    callback remove-source();
    callback refresh-sources();
    callback filter-changed(string);
    callback page-next();
    callback page-prev();
    callback play-channel(int);
    callback play-last-channel();
    callback toggle-favorite(int);
    callback reorder-channel(int, int);
    callback pause-video();
    callback stop-video();
    callback prev-video();
    callback next-video();
    callback seek-video(int);
    callback seek-percent(float);
    callback cycle-audio-track();
    callback cycle-subtitle-track();
    callback volume-delta(int);
    callback fullscreen-video();
    callback select-video-backend(string);
    callback snapshot-current();
    callback snapshot-all();
    callback export-m3u();
    callback export-favorites-m3u();
    callback check-channels();
    callback check-selected-channel();
    callback discover-vn();
    callback multiview-four();
    callback create-folder();
    callback put-in-folder();
    callback show-folder(string);
    callback clear-folder();
    callback start-recording();
    callback stop-recording();
    callback set-theme(string);
    callback add-alternate();
    callback remove-alternate();
    callback next-alternate();
    callback toggle-auto-failover();

    HorizontalLayout {
        spacing: 0px;
        if !root.player-fullscreen : Rectangle {
            width: root.rail-collapsed ? 76px : 224px;
            background: root.amoled-mode ? #070707 : (root.light-mode ? #ffffff : #101b29);
            border-width: 1px;
            border-color: #223347;
            VerticalLayout {
                padding: root.rail-collapsed ? 6px : 12px;
                spacing: 3px;
                Button { text: root.rail-collapsed ? "☰" : "☰  Thu gọn"; height: 38px; clicked => { root.rail-collapsed = !root.rail-collapsed; } }
                // Persistent, accessible settings button in the clickable
                // upper rail. Avoid bottom-edge hit-testing and status overlap.
                Button {
                    text: root.rail-collapsed ? "⚙" : "⚙  Cài đặt";
                    height: 38px;
                    primary: root.active-page == "settings";
                    clicked => { root.navigate("settings"); }
                }
                Rectangle {
                    height: root.rail-collapsed ? 50px : 64px;
                    HorizontalLayout {
                        padding: 8px;
                        spacing: 10px;
                        Rectangle {
                            width: 42px;
                            height: 42px;
                            border-radius: 12px;
                            background: #55277a;
                            Text { text: "▶"; color: #dbb4ff; font-size: 25px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        VerticalLayout {
                            visible: !root.rail-collapsed;
                            spacing: 3px;
                            Text { text: "Open IPTV Pro"; font-size: 17px; font-weight: 700; color: root.light-mode ? #203249 : #f2f5ff; }
                            Text { text: "RUST NATIVE · C3"; font-size: 9px; color: #a788cf; }
                        }
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 4px;
                        padding: 0px;
                if !root.rail-collapsed : Text { text: "THƯ VIỆN"; font-size: 10px; font-weight: 700; color: #718da8; height: 31px; vertical-alignment: bottom; }
                Button { text: root.rail-collapsed ? "▣" : "▣  Xem truyền hình"; height: 44px; primary: root.active-page == "tv"; clicked => { root.navigate("tv"); } }
                Button { text: root.rail-collapsed ? "★" : "★  Kênh yêu thích       " + root.favorites-count; height: 44px; primary: root.active-page == "fav"; clicked => { root.navigate("fav"); } }
                Button { text: root.rail-collapsed ? "◷" : "◷  Xem gần đây            " + root.recent-count; height: 44px; primary: root.active-page == "recent"; clicked => { root.navigate("recent"); } }
                Button { text: root.rail-collapsed ? "▤" : "▤  Lịch phát sóng EPG"; height: 44px; primary: root.active-page == "epg"; clicked => { root.navigate("epg"); } }
                Button { text: root.rail-collapsed ? "⊞" : "⊞  MultiView · 4 kênh"; height: 44px; primary: root.active-page == "multiview"; clicked => { root.navigate("multiview"); } }
                Button { text: root.rail-collapsed ? "▦" : "▦  Ảnh chụp kênh"; height: 44px; primary: root.active-page == "shots"; clicked => { root.navigate("shots"); } }
                Button { text: root.rail-collapsed ? "▥" : "▤  Thư mục kênh"; height: 44px; primary: root.active-page == "folders"; clicked => { root.navigate("folders"); } }
                if !root.rail-collapsed : Text { text: "CÔNG CỤ"; font-size: 10px; font-weight: 700; color: #718da8; height: 31px; vertical-alignment: bottom; }
                Button { text: root.rail-collapsed ? "◇" : "◇  Quản lý nguồn       " + root.sources-count; height: 44px; primary: root.active-page == "sources"; clicked => { root.navigate("sources"); } }
                Button { text: root.rail-collapsed ? "↗" : "↗  Sức khỏe kênh / Failover"; height: 44px; primary: root.active-page == "health"; clicked => { root.navigate("health"); } }
                Button { text: root.rail-collapsed ? "✚" : "✚  Smart IPTV Doctor"; height: 44px; primary: root.active-page == "doctor"; clicked => { root.navigate("doctor"); } }
                Button { text: root.rail-collapsed ? "◎" : "◎  Khám phá IPTV"; height: 44px; primary: root.active-page == "discovery"; clicked => { root.navigate("discovery"); } }
                Button { text: root.rail-collapsed ? "♙" : "♙  Hồ sơ / Khóa trẻ em"; height: 44px; primary: root.active-page == "profiles"; clicked => { root.navigate("profiles"); } }
                Button { text: root.rail-collapsed ? "⇩" : "⇩  Xuất M3U"; height: 44px; clicked => { root.export-m3u(); } }
                Button { text: root.rail-collapsed ? "★" : "★  Xuất M3U yêu thích"; height: 44px; clicked => { root.export-favorites-m3u(); } }
                

                    }
                }
                if !root.rail-collapsed : Rectangle {
                    height: 67px;
                    background: root.light-mode ? #e7eef8 : #192a3b;
                    border-radius: 10px;
                    VerticalLayout {
                        padding: 3px;
                        spacing: 1px;
                        Text { text: "●  Bản Rust Native"; visible: !root.rail-collapsed; color: root.accent; font-weight: 700; font-size: 12px; }
                        Text { text: "Nhánh thử nghiệm độc lập"; visible: !root.rail-collapsed; color: #9bb2c6; font-size: 11px; }
                    }
                }
            }
        }
        VerticalLayout {
            spacing: 0px;
            Rectangle {
                background: root.amoled-mode ? #000000 : (root.light-mode ? #eff4fa : #101825);
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
if (root.active-page == "tv" || root.active-page == "fav" || root.active-page == "recent") : VerticalLayout {
    vertical-stretch: 1; spacing: 8px;
    if !root.player-fullscreen : Rectangle {
    height: 44px; background: #142536; border-radius: 9px;
    HorizontalLayout {
        padding-left: 12px; padding-right: 8px; spacing: 9px;
        Text { text: "OPEN IPTV PRO  /  " + root.page-title; color: #e9f0fb; font-weight: 700; font-size: 13px; vertical-alignment: center; overflow: elide; }
        Button {
            text: "⚙ Cài đặt";
            width: 122px;
            height: 36px;
            clicked => { root.navigate("settings"); }
        }
        Rectangle { horizontal-stretch: 1; background: transparent; }
        Text { text: root.sources-count + " nguồn"; color: #9db8cb; font-size: 11px; vertical-alignment: center; }
        Button { text: "Mở M3U"; width: 92px; clicked => { root.open-m3u(); } }
        Button { text: "Thêm URL"; width: 100px; clicked => { root.navigate("sources"); } }
    }
}
    Rectangle {
    height: root.player-fullscreen ? root.height - 96px : 322px;
    background: #050a11; border-radius: 11px;
    border-width: 1px; border-color: #30455b; clip: true;
    Image { source: root.video-frame; width: parent.width; height: parent.height; image-fit: contain; visible: root.has-video-frame; }
    Rectangle {
        x: 12px; y: 10px; width: parent.width - 24px; height: 39px; border-radius: 7px; background: #142437;
        HorizontalLayout {
            padding-left: 12px; padding-right: 7px; spacing: 10px;
            Text { text: "●"; color: #f26377; font-size: 14px; vertical-alignment: center; }
            Text { text: root.video-is-live ? "TRỰC TIẾP" : "VIDEO"; color: #f2f7fd; font-size: 11px; font-weight: 700; vertical-alignment: center; }
            Text { text: root.video-status; color: #abc3d7; font-size: 11px; overflow: elide; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Button { text: root.video-backend-mode == "embedded" ? "Mở mpv ngoài" : "Nhúng video"; clicked => { root.select-video-backend(root.video-backend-mode == "embedded" ? "native" : "embedded"); } }
            Button { text: root.player-fullscreen ? "Thu nhỏ" : "Toàn màn"; clicked => { root.fullscreen-video(); } }
        }
    }
    Rectangle {
        visible: !root.has-video-frame; x: 18px; y: 76px; width: parent.width - 36px; height: 125px; background: transparent;
        VerticalLayout {
            spacing: 8px;
            Text { text: "▶"; font-size: 38px; color: root.accent; horizontal-alignment: center; }
            Text { text: root.video-hint; font-size: 16px; font-weight: 700; color: #e7effa; horizontal-alignment: center; wrap: word-wrap; }
            Text { text: "Mở M3U hoặc chọn kênh trong thư viện phía dưới"; color: #8fabc4; font-size: 11px; horizontal-alignment: center; }
        }
    }
    Rectangle {
        x: 12px; y: parent.height - 88px; width: parent.width - 24px; height: 78px; background: #142437; border-radius: 8px;
        VerticalLayout {
            padding: 7px; spacing: 4px;
            HorizontalLayout {
                spacing: 8px;
                Button { text: "−10s"; enabled: root.playback-controls-enabled; clicked => { root.seek-video(-10); } }
                Button { text: root.video-paused ? "▶ Phát" : "❚❚ Tạm dừng"; enabled: root.playback-controls-enabled; clicked => { root.pause-video(); } }
                Button { text: "−30s"; enabled: root.playback-controls-enabled; clicked => { root.seek-video(-30); } }
                Button { text: "Dừng"; enabled: root.playback-controls-enabled; clicked => { root.stop-video(); } }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Button { text: "Về LIVE"; enabled: root.playback-controls-enabled; clicked => { root.seek-video(999999); } }
            }
            Slider { visible: root.video-seekable; height: 14px; minimum: 0; maximum: 100; value: root.playback-progress; released(value) => { root.seek-percent(value); } }
            Rectangle { visible: !root.video-seekable; height: 3px; background: #34475c; }
            Text { text: root.playback-clock; color: #b4cfe1; font-size: 10px; horizontal-alignment: right; }
        }
    }
}
    if !root.player-fullscreen : ScrollView {
        vertical-stretch: 1;
        VerticalLayout { spacing: 9px;
            Rectangle {
                                height: 108px;
                                visible: !root.player-fullscreen;
                                background: root.amoled-mode ? #101010 : (root.light-mode ? #ffffff : #142231);
                                border-radius: 11px;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 9px;
                                    Text { text: root.playing-text; font-size: 15px; font-weight: 700; color: root.light-mode ? #203249 : #f4f7ff; }
                                    Text { text: root.playing-subtitle; color: #92adc4; font-size: 11px; }
                                    HorizontalLayout {
                                        spacing: 7px;
                                        Button { text: "⏮"; clicked => { root.prev-video(); } }
                                        Button { text: "▶ / ❚❚"; enabled: root.playback-controls-enabled; clicked => { root.pause-video(); } }
                                        Button { text: "■"; enabled: root.playback-controls-enabled; clicked => { root.stop-video(); } }
                                        Button { text: "⏭"; clicked => { root.next-video(); } }
                                        Rectangle { horizontal-stretch: 1; background: root.amoled-mode ? #101010 : (root.light-mode ? #ffffff : #142231); }
                                        Button { text: "−"; clicked => { root.volume-delta(-10); } }
                                        Text { text: root.volume-text; color: #abc5dc; vertical-alignment: center; font-size: 11px; }
                                        Button { text: "+"; clicked => { root.volume-delta(10); } }
                                        Button { text: root.muted ? "♫" : "♪̸"; clicked => { root.toggle-mute(); } }
                                        Button { text: "⛶"; clicked => { root.fullscreen-video(); } }
                                    }
                                }
                            }
                            Rectangle {
                                height: 68px;
                                visible: !root.player-fullscreen;
                                background: root.amoled-mode ? #101010 : (root.light-mode ? #ffffff : #142231);
                                border-radius: 10px;
                                VerticalLayout {
                                    padding: 9px;
                                    spacing: 5px;
                                    Text { text: "▤ ĐANG PHÁT / TIẾP THEO"; font-size: 11px; font-weight: 700; color: root.accent; }
                                    Text { text: root.selected-epg-text; font-size: 12px; color: root.light-mode ? #203249 : #d9e9f8; wrap: word-wrap; }
                                }
                            }
                            Rectangle {
                                height: 48px;
                                visible: !root.player-fullscreen;
                                background: root.amoled-mode ? #101010 : (root.light-mode ? #ffffff : #142231);
                                border-radius: 10px;
                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 10px;
                                    spacing: 10px;
                                    Text { text: "☷  Công cụ nhanh"; font-size: 14px; font-weight: 700; color: root.light-mode ? #203249 : #f3f7ff; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    Button { text: root.quick-tools-expanded ? "Thu gọn  ⌃" : "Mở rộng  ⌄"; clicked => { root.toggle-quick-tools(); } }
                                }
                            }
                            if root.quick-tools-expanded && !root.player-fullscreen : VerticalLayout {
                                spacing: 9px;
                                Rectangle {
                                    height: 110px;
                                    background: root.amoled-mode ? #101010 : (root.light-mode ? #ffffff : #142231);
                                    border-radius: 10px;
                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 8px;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text { text: "Khung hình: " + root.aspect-mode-text; color: root.light-mode ? #203249 : #d7e7f5; font-size: 12px; vertical-alignment: center; }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                            Button { text: "Vừa khung"; clicked => { root.set-aspect-mode("fit"); } }
                                            Button { text: "Lấp đầy"; clicked => { root.set-aspect-mode("fill"); } }
                                            Button { text: "Gốc"; clicked => { root.set-aspect-mode("original"); } }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text { text: "Âm thanh: " + (root.muted ? "Đang tắt tiếng" : "Đang bật tiếng"); color: root.light-mode ? #203249 : #d7e7f5; font-size: 12px; vertical-alignment: center; }
                                            Button { text: root.muted ? "Bật tiếng" : "Tắt tiếng"; clicked => { root.toggle-mute(); } }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                            Button { text: "Đổi audio"; clicked => { root.cycle-audio-track(); } }
                                            Button { text: "Đổi phụ đề"; clicked => { root.cycle-subtitle-track(); } }
                                        }
                                    }
                                }
                                Rectangle {
                                    height: 90px;
                                    background: root.amoled-mode ? #101010 : (root.light-mode ? #ffffff : #142231);
                                    border-radius: 10px;
                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 6px;
                                        HorizontalLayout {
                                            spacing: 7px;
                                            Text { text: "Tua / ghi hình"; color: root.light-mode ? #203249 : #cfdcf1; font-weight: 700; vertical-alignment: center; }
                                            Button { text: "−30s"; enabled: root.playback-controls-enabled; clicked => { root.seek-video(-30); } }
                                            Button { text: "−10s"; enabled: root.playback-controls-enabled; clicked => { root.seek-video(-10); } }
                                            Button { text: "Về LIVE"; enabled: root.playback-controls-enabled; clicked => { root.seek-video(999999); } }
                                            Button { text: "Ghi 60 giây"; clicked => { root.start-recording(); } }
                                        }
                                        Text { text: root.recording-text; color: #8eafca; font-size: 11px; }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 7px;
                                    Button { text: "✓ Kiểm tra kênh"; clicked => { root.check-channels(); } }
                                    Button { text: "▦ Snapshot"; clicked => { root.snapshot-current(); } }
                                    Button { text: "▦ Snapshot loạt"; clicked => { root.snapshot-all(); } }
                                    Button { text: "⇩ Xuất M3U"; clicked => { root.export-m3u(); } }
                                    Button { text: "■ Dừng ghi"; clicked => { root.stop-recording(); } }
                                }
                            }
                                    Rectangle {
                            visible: !root.player-fullscreen;
                            height: root.player-fullscreen ? 0px : 390px;
                            background: root.amoled-mode ? #101010 : (root.light-mode ? #ffffff : #142231);
                            border-radius: 11px;
                            border-width: 1px;
                            border-color: #2a3b50;
                            VerticalLayout {
                                padding: 11px;
                                spacing: 8px;
                                HorizontalLayout {
                                    Text { text: "KHÁM PHÁ KÊNH · " + root.selected-source-text; color: root.light-mode ? #203249 : #f5f8ff; font-weight: 700; font-size: 17px; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; background: root.amoled-mode ? #101010 : (root.light-mode ? #ffffff : #142231); }
                                    Button { text: "▶ Gần nhất"; clicked => { root.play-last-channel(); } }
                                    Button { text: "↻"; clicked => { root.refresh-sources(); } }
                                }
                                Text { text: root.count-text; color: #9cb4cb; font-size: 11px; }
                                if root.show-pagination : HorizontalLayout {
                                    spacing: 8px;
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    Button { text: "‹ Trước"; width: 105px; clicked => { root.page-prev(); } }
                                    Button { text: "Sau ›"; width: 105px; clicked => { root.page-next(); } }
                                }
                                LineEdit {
                                    text <=> root.search-text;
                                    placeholder-text: "⌕ Tìm kênh, nhóm, EPG...";
                                    edited(value) => { root.filter-changed(value); }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Button { text: "Tất cả"; width: 92px; clicked => { root.show-all(); } }
                                    Button { text: "★ Yêu thích"; width: 116px; clicked => { root.show-favorites(); } }
                                    Button { text: "◷ Gần đây"; width: 108px; clicked => { root.navigate("recent"); } }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                }
                                Text { text: root.selected-source-text; color: root.accent; font-size: 11px; }
                                ListView {
                                    for ch[i] in root.channels: Rectangle {
                                        height: 62px;
                                        background: root.selected-channel-index == i ? #304761 : (root.light-mode ? (Math.mod(i, 2) == 0 ? #edf2f9 : #f9fbfd) : (Math.mod(i, 2) == 0 ? #1a293b : #182436));
                                        border-width: root.selected-channel-index == i ? 1px : 0px;
                                        border-color: root.accent;
                                        border-radius: 5px;
                                        HorizontalLayout {
                                            padding: 7px;
                                            spacing: 6px;
                                            Rectangle {
                                                width: 40px; height: 40px; border-radius: 7px;
                                                background: #293d56;
                                                Image {
                                                    source: ch.logo;
                                                    width: parent.width;
                                                    height: parent.height;
                                                    image-fit: contain;
                                                    visible: ch.has-logo;
                                                }
                                                Text { text: "TV"; visible: !ch.has-logo; color: #b4cbe7; font-size: 11px; vertical-alignment: center; horizontal-alignment: center; }
                                            }
                                            VerticalLayout {
                                                spacing: 3px;
                                                Text { text: ch.title; color: root.light-mode ? #203249 : #f3f7ff; font-size: 13px; font-weight: 700; overflow: elide; }
                                                Text { text: ch.subtitle; color: #9cb3c8; font-size: 10px; overflow: elide; }
                                                Text { text: ch.health + "  " + ch.epg; color: #80cbbe; font-size: 10px; overflow: elide; }
                                            }
                                            Button { text: "▶"; width: 34px; clicked => { root.play-channel(i); } }
                                            Button { text: ch.favorite ? "★" : "☆"; width: 34px; clicked => { root.toggle-favorite(i); } }
                                            Button { text: "↑"; width: 24px; clicked => { root.reorder-channel(i, -1); } }
                                            Button { text: "↓"; width: 24px; clicked => { root.reorder-channel(i, 1); } }
                                        }
                                    }
                                }
                            }
                        }
        }
    }
}
                    if (root.active-page == "sources") : Rectangle {
                        background: root.amoled-mode ? #101010 : (root.light-mode ? #ffffff : #142231);
                        border-radius: 12px;
                        VerticalLayout {
                            padding: 20px;
                            spacing: 13px;
                            Text { text: "◈ Quản lý nguồn M3U"; color: root.light-mode ? #203249 : #f3f6ff; font-size: 21px; font-weight: 700; }
                            Text { text: "Thêm URL, mở file, làm mới playlist và quản lý nguồn độc lập với Electron."; color: #99b3cb; font-size: 12px; }
                            Text { text: "Chỉ nhập nguồn mà bạn có quyền truy cập và sử dụng. Tác giả không cung cấp kênh và không chịu trách nhiệm về nội dung người dùng thêm."; color: #e5bdb0; font-size: 12px; wrap: word-wrap; }
                             CheckBox { text: "Tôi xác nhận có quyền sử dụng nguồn M3U này (mỗi lần nhập)"; checked <=> root.import-rights-confirmed; }
                             LineEdit { text <=> root.url-input; placeholder-text: "https://.../playlist.m3u"; }
                             CheckBox { text: "Tôi đồng ý điều khoản và tự xác minh quyền với nguồn Smart Discovery"; checked <=> root.discovery-rights-confirmed; }
                            HorizontalLayout {
                                Button { text: "+ Thêm URL M3U"; clicked => { root.add-url(); } }
                                Button { text: "Mở file M3U"; clicked => { root.open-m3u(); } }
                                Button { text: "Làm mới tất cả URL"; clicked => { root.refresh-sources(); } }
                                Button { text: "Khám phá Việt Nam"; clicked => { root.discover-vn(); } }
                            }
                            Text { text: "DANH SÁCH NGUỒN · " + root.sources-count; color: #b8a0ed; font-size: 12px; font-weight: 700; }
                            ListView {
                                // A single M3U source must not reserve a tall blank panel.
                                height: root.sources-count == "0" ? 58px : (root.sources-count == "1" ? 62px : 235px);
                                for s[i] in root.sources: Rectangle {
                                    height: 51px;
                                    background: root.light-mode ? (Math.mod(i, 2) == 0 ? #edf2f9 : #f9fbfd) : (Math.mod(i, 2) == 0 ? #1c3046 : #17273a);
                                    HorizontalLayout {
                                        padding: 7px; spacing: 8px;
                                        Text { text: s.title; color: root.light-mode ? #203249 : #f5f8ff; font-size: 13px; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; background: root.light-mode ? #eef3f9 : #17273a; }
                                        Text { text: s.count; color: #abc1d7; font-size: 11px; vertical-alignment: center; }
                                        Button { text: "Chọn"; clicked => { root.select-source(i); } }
                                    }
                                }
                            }
                            Text { text: root.selected-source-text; color: root.accent; font-size: 12px; }
                            Text { text: "SỬA NGUỒN ĐÃ CHỌN"; color: root.accent; font-weight: 700; font-size: 11px; }
                            Text { text: "Đổi tên hoặc URL cho nguồn được chọn. URL mới sẽ được tải và kiểm tra trước khi thay thế; nếu lỗi vẫn giữ nguyên dữ liệu cũ. Cần xác nhận quyền M3U ở phía trên."; color: #a5bacd; font-size: 11px; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 8px;
                                LineEdit { text <=> root.source-edit-name; placeholder-text: "Tên nguồn"; }
                                Button { text: "Đổi tên"; clicked => { root.rename-source(); } }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                LineEdit { text <=> root.source-edit-url; placeholder-text: "https://.../playlist.m3u"; }
                                Button { text: "Kiểm tra & thay URL"; clicked => { root.update-source-url(); } }
                            }
                            HorizontalLayout { Button { text: "Xem tất cả"; clicked => { root.show-all(); } } Button { text: "Xóa nguồn đang chọn (xác nhận 2 lần)"; clicked => { root.remove-source(); } } }
                        }
                    }
                    if (root.active-page == "epg") : Rectangle {
                        background: root.amoled-mode ? #101010 : (root.light-mode ? #ffffff : #142231); border-radius: 12px;
                        VerticalLayout {
                            padding: 20px; spacing: 13px;
                            Text { text: "▤ Lịch phát sóng EPG / XMLTV"; color: root.light-mode ? #203249 : #f3f6ff; font-size: 21px; font-weight: 700; }
                            Text { text: "XMLTV: đang phát, tiếp theo và lịch đầy đủ theo ngày. Tự tải EPG khi mở app; cache lịch hiện tại 10 phút."; color: #99b3cb; font-size: 12px; }
                            HorizontalLayout {
                                 Button { text: "Gzip · mặc định"; clicked => { root.select-epg-preset("gzip"); } }
                                 Button { text: "XML chuẩn"; clicked => { root.select-epg-preset("xml"); } }
                                 Button { text: "Gzip Việt hóa"; clicked => { root.select-epg-preset("gzip-vi"); } }
                                 Button { text: "XML Việt hóa"; clicked => { root.select-epg-preset("xml-vi"); } }
                             }
                             Text { text: "EPG.pw chỉ là dự phòng, không bật mặc định. Hãy kiểm tra điều khoản của nguồn EPG."; color: #a8bacd; font-size: 11px; }
                             LineEdit { text <=> root.epg-url-input; placeholder-text: "https://epg.io.vn/epg.xml.gz"; }
                            HorizontalLayout { Button { text: "Tải EPG từ URL"; clicked => { root.load-epg-url(); } } Button { text: "Nhập EPG trên máy"; clicked => { root.import-epg(); } } }
                            Rectangle { height: 95px; background: root.light-mode ? #eef3f9 : #1b3046; border-radius: 8px;
                                Text { text: root.selected-epg-text; color: #d7e7f5; font-size: 14px; wrap: word-wrap; vertical-alignment: center; horizontal-alignment: center; }
                            }
                            Rectangle { height: 1px; background: #344157; }
                            HorizontalLayout {
                                spacing: 8px;
                                Button { text: "‹ Trước"; clicked => { root.guide-day(-1); } }
                                Button { text: "Hôm nay"; clicked => { root.guide-day(0); } }
                                Text { text: root.guide-day-text; color: root.accent; font-size: 15px; font-weight: 700; vertical-alignment: center; }
                                Button { text: "Sau ›"; clicked => { root.guide-day(1); } }
                            }
                            LineEdit {
                                text <=> root.epg-search;
                                placeholder-text: "Tìm kênh, phim, tập phim trong EPG...";
                                edited(value) => { root.guide-filter-changed(value); }
                            }
                            Text { text: root.guide-count; color: #a8c1d6; font-size: 11px; }
                            ListView {
                                height: 315px;
                                for entry[i] in root.guide-rows: Rectangle {
                                    height: 57px;
                                    background: root.light-mode ? (Math.mod(i, 2) == 0 ? #eef3f9 : #ffffff) : (Math.mod(i, 2) == 0 ? #1c3044 : #182638);
                                    border-radius: 5px;
                                    HorizontalLayout {
                                        padding: 7px;
                                        spacing: 8px;
                                        Text { text: entry.time; color: root.accent; font-size: 11px; min-width: 98px; vertical-alignment: center; }
                                        VerticalLayout {
                                            spacing: 3px;
                                            Text { text: entry.channel; color: root.light-mode ? #203249 : #f3f7ff; font-size: 12px; font-weight: 700; overflow: elide; }
                                            Text { text: entry.title; color: root.light-mode ? #394c5f : #afc7df; font-size: 11px; overflow: elide; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if (root.active-page == "multiview") : Rectangle {
                        background: root.amoled-mode ? #101010 : (root.light-mode ? #ffffff : #142231); border-radius: 12px;
                        VerticalLayout {
                            padding: 20px; spacing: 12px;
                            Text { text: "⊞ MultiView · 4 kênh"; color: root.light-mode ? #203249 : #f3f6ff; font-size: 21px; font-weight: 700; }
                            Text { text: "Mở tối đa bốn nguồn phát thành các cửa sổ mpv độc lập; chỉ kênh đầu phát âm thanh."; color: #a8c1d6; font-size: 12px; }
                            HorizontalLayout {
                                Rectangle { background: root.light-mode ? #152231 : #070c13; border-radius: 9px; Text { text: "1  ▶"; color: #b68ae6; font-size: 25px; vertical-alignment: center; horizontal-alignment: center; } }
                                Rectangle { background: root.light-mode ? #152231 : #070c13; border-radius: 9px; Text { text: "2  ▶"; color: #b68ae6; font-size: 25px; vertical-alignment: center; horizontal-alignment: center; } }
                            }
                            HorizontalLayout {
