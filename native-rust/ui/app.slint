                            }
                            HorizontalLayout {
                                Text { text: "Tự chuyển khi mpv báo lỗi: " + root.auto-failover-text; color: #c4d5e8; font-size: 12px; vertical-alignment: center; }
                                Button { text: "Bật / Tắt"; clicked => { root.toggle-auto-failover(); } }
